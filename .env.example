# =============================================================================
# SecDash Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=SecDash
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-another-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=secdash
POSTGRES_USER=secdash_user
POSTGRES_PASSWORD=change-this-secure-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_ALWAYS_EAGER=false  # Set to true for testing without Celery worker

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# GitLab Integration
# -----------------------------------------------------------------------------
GITLAB_TOKEN=glpat-your-gitlab-token-here
GITLAB_URL=https://gitlab.com

# -----------------------------------------------------------------------------
# Ollama (Local LLM)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_SUMMARY=llama3.2
OLLAMA_MODEL_CODE=codellama
OLLAMA_MODEL_ADVANCED=deepseek-coder
OLLAMA_TIMEOUT=120
OLLAMA_ENABLED=true

# -----------------------------------------------------------------------------
# Notification Services
# -----------------------------------------------------------------------------
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ENABLED=false

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
DISCORD_ENABLED=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=secdash@example.com
SMTP_FROM_NAME=SecDash
EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
SEMGREP_RULES=auto  # auto, p/security-audit, p/owasp-top-ten
TRIVY_SEVERITY=HIGH,CRITICAL
SCAN_TIMEOUT=3600  # seconds
MAX_PARALLEL_SCANS=3

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
TEMP_REPO_DIR=/tmp/secdash_repos
SCAN_RESULTS_DIR=/app/scan_results

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
RELOAD=true  # FastAPI auto-reload
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
